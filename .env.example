# RPC endpoint for the target network (Arbitrum One for fork tests and deployment)
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Deployer private key. Never commit the real value
PRIVATE_KEY=0x...

# Uniswap V2 router and factory on the target network. Verify against the official deployment docs
V2_ROUTER=0x...
V2_FACTORY=0x...

# Token addresses on the target network (the USDT/DAI pair must exist in the factory)
USDT=0x...
DAI=0x...
